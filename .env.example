# Plantilla de configuracion de SIGA-Lab.
# Copiar como .env y ajustar por entorno. NUNCA versionar el archivo .env real (criterio C3).

SIGA_ENV=desarrollo
SIGA_PUERTO=3000

# Reglas de negocio parametrizables por la coordinacion de laboratorios (criterio C2)
SIGA_DURACION_FRANJA_MIN=60
SIGA_ANTELACION_MINIMA_H=2
SIGA_MAX_RESERVAS_USUARIO=3

# Secretos: valores reales gestionados fuera del repositorio
SIGA_DB_URL=postgres://usuario:clave@localhost:5432/sigalab
SIGA_SMTP_CLAVE=cambiar-en-cada-entorno
